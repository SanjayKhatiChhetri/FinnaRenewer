# ─────────────────────────────────────────────────────────────────
# Oula Finna Auto-Renewer — Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────

# REQUIRED — your Finna library card credentials (Database login).
# These never change, so you only set them once.
FINNA_ID=your.library.username
FINNA_PASSWORD=your_password

# OPTIONAL but recommended — paste your browser's full cookie string here.
# Used to pre-seed the Cloudflare clearance cookie (cf_clearance) so the
# login request isn't blocked. You only need to update this if Cloudflare
# starts challenging requests — typically once a month or less often.
#
# How to get it:
#   1. Log in at https://oula.finna.fi in your browser
#   2. Open DevTools (F12) → Network tab → reload → click any request
#   3. Copy the full value of the "cookie:" request header
FINNA_COOKIE=PHPSESSID=...; loginToken=...; cf_clearance=...; language=en-gb

# OPTIONAL — Discord webhook for notifications.
# Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# OPTIONAL — renew loans due within this many days (default: 7)
RENEW_DAYS_BEFORE=7