# Database (Vercel Postgres / Neon)
DATABASE_URL=postgres://...

# Auth.js
AUTH_SECRET=           # openssl rand -base64 32
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Encryption (for library credentials at rest)
